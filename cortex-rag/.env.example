DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cortex
# Local Compose database password; use a URL-safe random value.
POSTGRES_PASSWORD=replace_with_a_random_url_safe_password
CORTEX_API_PORT=8000
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Use a unique secret; Grafana is bound to localhost by default.
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password
OPENAI_API_KEY=replace_me
# Generate a random secret with at least 32 characters. Protected routes fail closed if omitted.
API_ACCESS_TOKEN=replace_with_a_random_secret_of_at_least_32_characters
# Shared fixed-window limit per API key; applies to /documents, /ask and /metrics.
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY_SECONDS=0.5
OPENAI_RETRY_MAX_DELAY_SECONDS=8
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
EMBEDDING_MAX_CONCURRENCY=4
CHAT_MAX_CONCURRENCY=4
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# CORTEX Studio trace query backend (internal Docker network; do not expose Tempo publicly).
CORTEX_TEMPO_URL=http://localhost:3200
CORTEX_TEMPO_TIMEOUT_SECONDS=3
# Optional OpenTelemetry export. Leave unset to avoid sending telemetry externally.
OTEL_SERVICE_NAME=cortex-rag
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Or set OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
